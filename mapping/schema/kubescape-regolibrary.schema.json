{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latticework.systems/schema/kubescape-regolibrary-1.0.json",
  "title": "Latticework ISM framework for kubescape/regolibrary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ism_release", "generated", "framework", "controls"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "ism_release": {"type": "string", "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])$"},
    "generated": {"const": false},
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^20[0-9]{2}\\.(0[1-9]|1[0-2])$"}
      }
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/control"}
    }
  },
  "$defs": {
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control_id", "name", "ism_ids", "related_checks", "rationale", "description", "evidence_boundary"],
      "properties": {
        "control_id": {"type": "string", "pattern": "^C-[0-9]{4}$"},
        "name": {"type": "string", "minLength": 1},
        "ism_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^ISM-[0-9]{4}$"}
        },
        "related_checks": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "rationale": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "evidence_boundary": {"type": "string", "minLength": 1}
      }
    }
  }
}
