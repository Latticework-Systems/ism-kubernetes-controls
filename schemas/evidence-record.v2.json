{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latticework.systems/schema/evidence-record-2.0.json",
  "title": "Latticework assessor evidence record v2",
  "description": "The collected result records unassessed source records and extracted native CI fields; it never establishes implementation, approval or satisfaction. record_id is SHA-256 of this object excluding record_id, with sorted keys, compact UTF-8 JSON and no trailing newline. Evidence supports a bounded observation, not a complete control assessment.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "record_id",
    "ism_control",
    "system_id",
    "source",
    "resource",
    "result",
    "observed_at",
    "mapping",
    "responsibility",
    "evidence_ref"
  ],
  "properties": {
    "schema": {
      "const": "latticework.evidence-record/v2"
    },
    "record_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Optional digest of the captured source payload. Change notifications compare this digest when present; evidence_ref still authenticates the complete raw capture including observation timestamps."
    },
    "ism_control": {
      "type": "string",
      "pattern": "^ISM-[0-9]{4}$"
    },
    "system_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "detector",
        "detector_version"
      ],
      "properties": {
        "type": {
          "enum": [
            "kubernetes",
            "host",
            "pipeline",
            "cloud",
            "records"
          ]
        },
        "detector": {
          "type": "string",
          "minLength": 1
        },
        "detector_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "namespace",
        "uri"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": "string"
        },
        "uri": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "result": {
      "enum": [
        "pass",
        "fail",
        "not_observable",
        "inherited",
        "error",
        "collected"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_sha256",
        "git_sha",
        "ism_catalogue_release"
      ],
      "properties": {
        "file_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "git_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "ism_catalogue_release": {
          "type": "string",
          "pattern": "^20[0-9]{2}\\.[0-9]{2}\\.[0-9]+$"
        }
      }
    },
    "responsibility": {
      "enum": [
        "csp-inherited",
        "shared",
        "customer-platform",
        "customer-workload",
        "not-kubernetes-observable"
      ]
    },
    "evidence_ref": {
      "type": "string",
      "format": "uri"
    },
    "notes": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "const": "collected"
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "properties": {
          "source": {
            "properties": {
              "type": {
                "enum": ["records", "pipeline"]
              }
            }
          }
        }
      }
    }
  ]
}
